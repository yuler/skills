#!/usr/bin/env bash
# Print the Gmail app password to stdout. Never logs the secret.
#
# Resolution order:
#   1. Environment variable HIMALAYA_GMAIL_APP_PASSWORD
#   2. File HIMALAYA_GMAIL_APP_PASSWORD_FILE, or
#      ~/.config/himalaya/gmail-app-password
#
# The secret file should be mode 600 and contain only the Google app
# password (spaces optional). This script is not a login store.
set -euo pipefail

if [[ -n "${HIMALAYA_GMAIL_APP_PASSWORD:-}" ]]; then
  # App passwords may be stored with spaces; Gmail accepts either form.
  printf '%s' "${HIMALAYA_GMAIL_APP_PASSWORD}"
  exit 0
fi

file="${HIMALAYA_GMAIL_APP_PASSWORD_FILE:-${HOME}/.config/himalaya/gmail-app-password}"
if [[ -f "${file}" ]]; then
  # Strip a single trailing newline only; keep any interior spaces.
  python3 -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); sys.stdout.write(p.read_text().removesuffix("\n"))' "${file}"
  exit 0
fi

echo "himalaya-gmail-secret: no app password found." >&2
echo "Set HIMALAYA_GMAIL_APP_PASSWORD, or write the app password to:" >&2
echo "  ${file}" >&2
echo "Create one at https://myaccount.google.com/apppasswords (2-Step Verification required)." >&2
echo "Do not use the Google account password. Do not put the secret in config.toml." >&2
exit 1
